# Secretos
.env
*.env
!.env.example

# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Herramientas locales
.claude/

# Datos GIS pesados y generados
proyecto/data/raw/*
!proyecto/data/raw/FUENTES.md
!proyecto/data/raw/.gitkeep

# Rasters / capas pesadas en cualquier ubicacion
*.tif
*.tiff
*.vrt
*.img
*.asc
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.geojson

# Datos procesados: NO se versionan (se regeneran en cada ejecución de la
# herramienta); solo se conservan la estructura y su documentación.
!proyecto/data/processed/**/.gitkeep
!proyecto/data/processed/README.md

# Notebooks: checkpoints
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db

# Estadísticas GDAL/QGIS (caché derivado, se regenera automáticamente)
*.aux.xml
proyecto/data/processed/**/*.aux.xml

# Vídeo de respaldo de la presentación: se versiona la versión comprimida
# (<100 MB); cualquier otro original pesado en esa carpeta queda fuera.
docs/entregable/assets/video/*
!docs/entregable/assets/video/VideoTut_2.mp4
