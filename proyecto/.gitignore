# Secretos
.env

# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Datos GIS: no versionar capas pesadas ni rasters generados (sí versionar FUENTES.md y data/config)
data/raw/*
!data/raw/FUENTES.md
!data/raw/.gitkeep
!data/raw/openTopography/
!data/raw/openTopography/**/
!data/raw/openTopography/**/*.gitkeep
# Rasters / capas pesadas en cualquier ubicación
*.tif
*.tiff
*.vrt
*.img
*.asc
*.aux.xml
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.geojson
# excepción: ficheros de configuración del caso de estudio sí se versionan
!data/config/**
# excepción: los datos procesados SÍ se versionan (rasters/capas generados incluidos)
!data/processed/**

# Notebooks: checkpoints
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db
