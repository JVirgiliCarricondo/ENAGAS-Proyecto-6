# Secretos
.env

# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Datos GIS: no versionar capas pesadas ni rasters generados (sí versionar FUENTES.md y data/config)
data/raw/
# Rasters / capas pesadas en cualquier ubicación
*.tif
*.tiff
*.vrt
*.img
*.asc
*.aux.xml
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.geojson
# excepción: ficheros de configuración del caso de estudio sí se versionan
!data/config/**
# excepción: assets estáticos de la app (p. ej. el polígono de tierra firme
# para validar que origen/destino no caen en el mar) sí se versionan
!src/app/assets/**
# datos procesados: NO se versionan (se regeneran en cada ejecución de la
# herramienta); solo se conservan la estructura y su documentación
!data/processed/**/.gitkeep
!data/processed/README.md
# estilos QGIS y logs generados por el pipeline
*.qml
data/processed/log_*.txt

# Notebooks: checkpoints
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db
