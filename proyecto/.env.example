# Copia este fichero a .env y rellena tus valores. NUNCA subas .env al control de versiones.
# La mayoría de las capas son públicas y no requieren clave; usa estas variables solo si una
# fuente concreta exige autenticación o tienes un endpoint propio.

# --- Claves de descarga (si alguna fuente lo requiere) ---
# COPERNICUS_USER=
# COPERNICUS_PASSWORD=
# Algunos servicios de Copernicus / CDSE usan token OAuth:
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# --- Endpoints (opcional; por defecto los oficiales) ---
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# IGN_WFS_URL=
# IGME_WCS_URL=

# --- Rutas (opcional; por defecto relativas al proyecto) ---
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed
# CONFIG_DIR=data/config

# --- CRS y rejilla de trabajo (por defecto en data/config/escenario.yaml) ---
# CRS_TRABAJO=EPSG:25830
# RESOLUCION_M=30
